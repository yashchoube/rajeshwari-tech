# Copy these into .env.local for local preview (mirror Vercel Production / Preview).
# In Vercel: Settings → Environment Variables → copy values (never commit real secrets).

# Required for data + admin (same Postgres / Neon connection string as Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Admin login (match Vercel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Must match Vercel — used to sign admin session cookies
JWT_SECRET=your-jwt-secret-from-vercel

# NextAuth (if you use it elsewhere; optional for this app’s admin cookie auth)
NEXTAUTH_URL=https://your-project.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-from-vercel

# Public site URL (local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: only if admin must use a fixed cookie domain (e.g. .rajeshwaritech.com).
# Leave unset for localhost and *.vercel.app previews.
# ADMIN_COOKIE_DOMAIN=
